# ─── Modo Mock ───────────────────────────────────────────────────────────────
# true  → datos en memoria locales (ideal para probar la app al instante sin backend)
# false → conecta a tu Cloudflare Worker con Cloudflare D1
EXPO_PUBLIC_USE_MOCK=true

# ─── Cloudflare D1 API (Requerido solo si EXPO_PUBLIC_USE_MOCK=false) ─────────
EXPO_PUBLIC_API_URL=https://tu-worker.tu-subdominio.workers.dev
EXPO_PUBLIC_API_TOKEN=tu_token_aqui
