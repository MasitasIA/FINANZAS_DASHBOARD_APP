{
  "expo": {
    "name": "Finanzas",
    "slug": "finanzas_dashboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "finanzas",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.finanzas"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0f1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.personal.finanzas",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "855989f3-b75f-4790-8b3a-ce30105e7be6"
      }
    }
  }
}
